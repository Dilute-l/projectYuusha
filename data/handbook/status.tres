script = ExtResource("1_s1mvf")
id = &"status"
category = &"monster"
title = "属性入门101"
body = "1.不同的职业有不同的主属性。
战士：力量 法师：智力 牧师：感知
2.属性可以用于衡量一个人被编入队伍时能做出的奉献。
3.属性要经过官方机构验证并且还要有印章！"
