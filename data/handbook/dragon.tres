[ext_resource type="Script" uid="uid://by0tcgfmhfwsq" path="res://scripts/resources/handbook_entry.gd" id="1_nse0h"]

[resource]
script = ExtResource("1_nse0h")
id = &"dragon"
category = &"monster"
title = "龙"
body = "只要在冒险故事里面加上一只龙，就能让整个故事显得非常有吸引力？但那是……废物的思维！
虽然一部分的龙是善良，且愿意帮助人类的，但是大部分的龙都是贪婪而且邪恶的，大多数龙都具有超越人类的智慧。你说白龙？额……他们是例外。
只有冒险者中的佼佼者才有和哪怕是未成年的龙交战的实力。他们的鳞片要到成年才发育完全，但是即便是青年龙的吐息也十分致命。
栖息地：高山、洞穴
攻击方式：吐息、龙爪、扫尾
弱点：头下方的逆鳞
"
unlock_condition = "day>=3"
metadata/_custom_type_script = "uid://by0tcgfmhfwsq"
